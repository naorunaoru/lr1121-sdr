diff --git a/core/src/gui/widgets/fft_signal_info.h b/core/src/gui/widgets/fft_signal_info.h
new file mode 100644
index 0000000..d94aac5
--- /dev/null
+++ b/core/src/gui/widgets/fft_signal_info.h
@@ -0,0 +1,51 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace ImGui {
+    // Pure FFT-line measurement, shared by the meter and VFO tooltip.
+    // False means that signal/noise cannot both be estimated from this span.
+    inline bool calculateFFTSignalInfo(const float* line, int size, double span,
+        double center, double bandwidth, float& strength, float& snr) {
+        strength = snr = 0.0f;
+        if (!line || size <= 0 || !std::isfinite(span) || span <= 0.0 ||
+            !std::isfinite(center) || !std::isfinite(bandwidth) || bandwidth <= 0.0) {
+            return false;
+        }
+        double low = center - bandwidth / 2.0;
+        double high = center + bandwidth / 2.0;
+        if (low >= span / 2.0 || high < -span / 2.0) { return false; }
+
+        // Clamp as floating point BEFORE converting to an index. Boundaries
+        // may equal size, but dereferenced indices must always be smaller.
+        auto boundary = [=](double frequency) {
+            return static_cast<int>(std::clamp((frequency / span + 0.5) * size, 0.0, double(size)));
+        };
+        int signalBegin = boundary(low);
+        int signalEnd = std::min(boundary(high), size - 1) + 1;
+        int leftBegin = boundary(center - bandwidth);
+        int rightEnd = boundary(center + bandwidth);
+        if (signalBegin >= signalEnd) { return false; }
+
+        double noiseSum = 0.0;
+        int noiseCount = 0;
+        for (int i = leftBegin; i < signalBegin; ++i) {
+            noiseSum += line[i];
+            ++noiseCount;
+        }
+        for (int i = signalEnd; i < rightEnd; ++i) {
+            noiseSum += line[i];
+            ++noiseCount;
+        }
+        if (noiseCount == 0) { return false; }
+
+        float peak = -std::numeric_limits<float>::infinity();
+        for (int i = signalBegin; i < signalEnd; ++i) { peak = std::max(peak, line[i]); }
+        float estimate = peak - noiseSum / noiseCount;
+        if (!std::isfinite(peak) || !std::isfinite(estimate)) { return false; }
+        strength = peak;
+        snr = estimate;
+        return true;
+    }
+}
